{
  "manifest_version": 3,
  "name": "微存抓取扩展",
  "version": "1.2.3",
  "description": "使用当前浏览器的微博登录状态读取长文与图片，并交给微存在本地归档。",
  "permissions": [
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://weibo.com/*",
    "https://*.weibo.com/*",
    "https://m.weibo.cn/*",
    "https://sinaimg.cn/*",
    "https://*.sinaimg.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://driftingboats.github.io/weibo-article-archive/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "微存抓取扩展",
    "default_popup": "popup.html"
  }
}
